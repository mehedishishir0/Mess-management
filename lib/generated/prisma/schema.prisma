generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Mess {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  messName    String      @unique
  managerName String
  email       String      @unique
  password    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  members     Member[]
  days        MealDay[]
  expenses    Expense[]
  utilities   Utility[]
  overrides   Override[]
  houseRents  HouseRent[]
}

model Member {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  messId     String      @db.ObjectId
  externalId String
  name       String
  initials   String
  color      String
  houseRent  Float       @default(0)
  mess       Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  meals      MealEntry[]
  expenses   Expense[]
  overrides  Override?
  houseRents HouseRent[]

  @@unique([messId, externalId])
  @@index([messId])
}

model MealDay {
  id      String      @id @default(auto()) @map("_id") @db.ObjectId
  messId  String      @db.ObjectId
  date    String
  label   String
  mess    Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  entries MealEntry[]

  @@unique([messId, date])
}

model MealEntry {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  dayId    String  @db.ObjectId
  memberId String  @db.ObjectId
  count    Int
  day      MealDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([dayId, memberId])
}

model Expense {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  messId   String @db.ObjectId
  memberId String @db.ObjectId
  category String
  amount   Float
  mess     Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messId, memberId, category])
}

model Utility {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  messId     String @db.ObjectId
  externalId String
  name       String
  amount     Float
  mess       Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, externalId])
}

model Override {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  messId    String @db.ObjectId
  memberId  String @unique @db.ObjectId
  utilities Float?
  mealRate  Float?
  mess      Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model HouseRent {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  messId   String @db.ObjectId
  memberId String @db.ObjectId
  amount   Float
  monthKey String
  mess     Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messId, memberId, monthKey])
  @@index([messId])
}
